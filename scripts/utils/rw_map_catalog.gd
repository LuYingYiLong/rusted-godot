static func list_map_names() -> Array[String]:
	var names: Array[String] = []
	for map_name: String in MAP_DOCUMENTS:
		names.append(map_name)
	return names


static func load_map(map_name: String) -> RwXmlDocument:
	var file_name: String = map_name.replace("\\", "/").get_file()
	return _load_document(str(MAP_DOCUMENTS.get(file_name, "")))


static func load_tileset(source_path: String) -> RwXmlDocument:
	var normalized: String = source_path.replace("\\", "/").trim_prefix("./")
	var uid: String = str(TILESET_DOCUMENTS.get(normalized, ""))
	if uid.is_empty():
		uid = str(TILESET_DOCUMENTS.get(normalized.get_file(), ""))
	return _load_document(uid)


static func load_texture(image_path: String) -> Texture2D:
	var file_name: String = image_path.replace("\\", "/").get_file()
	var uid: String = str(TEXTURES.get(file_name, ""))
	if uid.is_empty():
		return null
	return ResourceLoader.load(uid) as Texture2D


static func _load_document(uid: String) -> RwXmlDocument:
	if uid.is_empty():
		return null
	return ResourceLoader.load(uid) as RwXmlDocument
