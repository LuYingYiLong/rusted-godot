## 返回指定相对路径的纹理，找不到时返回 null
static func load_texture(image_key: String) -> Texture2D:
	var uid: String = str(TEXTURES.get(image_key, ""))
	if uid.is_empty():
		return null
	return ResourceLoader.load(uid) as Texture2D
